# Runtime identity
LGWRAW_ENVIRONMENT=production
LGWRAW_AUTH_KEY=replace-with-a-long-random-value
LGWRAW_BASE_URL=https://images.example.com
LGWRAW_STRICT_SECRET_SOURCES=true

# PostgreSQL
POSTGRES_DB=dev_sh_ai_db
POSTGRES_USER=dev_sh_ai
POSTGRES_PASSWORD=replace-with-a-strong-password
STORAGE_BACKEND=postgres
DATABASE_URL=postgresql+asyncpg://dev_sh_ai:replace-with-a-strong-password@127.0.0.1:5432/dev_sh_ai_db
# Docker local development uses the host gateway instead of container loopback.
DOCKER_DATABASE_URL=postgresql+asyncpg://dev_sh_ai:replace-with-a-strong-password@host.docker.internal:5432/dev_sh_ai_db
IMAGE_TASK_DB_POOL_SIZE=10
IMAGE_TASK_DB_MAX_OVERFLOW=20

# Redis queue
REDIS_PASSWORD=replace-with-a-strong-password
IMAGE_TASK_QUEUE_ENABLED=true
IMAGE_TASK_EXECUTOR=celery
IMAGE_TASK_REDIS_URL=redis://:replace-with-a-strong-password@redis:6379/0
IMAGE_TASK_QUEUE_NAME=ai_image_tasks
IMAGE_TASK_MAX_RETRIES=2
# 0 = auto from account pool; set a fixed value to cap global concurrency
IMAGE_TASK_TOTAL_CONCURRENCY=5
IMAGE_TASK_WORKER_CONCURRENCY=5
IMAGE_TASK_OWNER_CONCURRENCY=2
IMAGE_TASK_OWNER_PENDING_LIMIT=30
IMAGE_TASK_SLOT_LEASE_SECS=7200

# OpenAI-compatible relay
LGWRAW_OPENAI_RELAY_ENABLED=true
LGWRAW_OPENAI_RELAY_BASE_URL=https://relay.example.com/v1
LGWRAW_OPENAI_RELAY_API_KEY=replace-with-relay-api-key
LGWRAW_PROMPT_ANALYSIS_MODEL=gpt-4o

# Qiniu reference uploads
LGWRAW_QINIU_ACCESS_KEY=replace-with-qiniu-access-key
LGWRAW_QINIU_SECRET_KEY=replace-with-qiniu-secret-key
LGWRAW_QINIU_BUCKET=replace-with-bucket
LGWRAW_QINIU_DOMAIN=https://cdn.example.com
LGWRAW_QINIU_UPLOAD_URL=https://upload-z0.qiniup.com
LGWRAW_QINIU_PREFIX=lgwraw/reference
LGWRAW_QINIU_TASK_PREFIX=lgwraw/task-assets

# Optional AI review
LGWRAW_AI_REVIEW_ENABLED=false
LGWRAW_AI_REVIEW_BASE_URL=
LGWRAW_AI_REVIEW_API_KEY=
LGWRAW_AI_REVIEW_MODEL=
LGWRAW_AI_REVIEW_FAIL_OPEN=true

# Optional proxy and Cloudflare clearance
LGWRAW_PROXY_RUNTIME_ENABLED=false
LGWRAW_PROXY_EGRESS_MODE=direct
LGWRAW_PROXY_URL=
LGWRAW_RESOURCE_PROXY_URL=
LGWRAW_CF_COOKIES=
LGWRAW_CF_CLEARANCE=
LGWRAW_FLARESOLVERR_URL=

# Optional WebDAV or MinIO image storage
LGWRAW_IMAGE_STORAGE_ENABLED=false
LGWRAW_IMAGE_STORAGE_MODE=local
LGWRAW_IMAGE_STORAGE_PROVIDER=qiniu
LGWRAW_WEBDAV_URL=
LGWRAW_WEBDAV_USERNAME=
LGWRAW_WEBDAV_PASSWORD=
LGWRAW_WEBDAV_ROOT_PATH=lgwraw/images
LGWRAW_MINIO_ENDPOINT=
LGWRAW_MINIO_ACCESS_KEY=
LGWRAW_MINIO_SECRET_KEY=
LGWRAW_MINIO_BUCKET=
LGWRAW_MINIO_ROOT_PATH=raw-photo/images
LGWRAW_QINIU_REGION=z0
LGWRAW_QINIU_PRIVATE=false

# Optional Cloudflare R2 backups
LGWRAW_BACKUP_ENABLED=false
LGWRAW_BACKUP_ACCOUNT_ID=
LGWRAW_BACKUP_ACCESS_KEY_ID=
LGWRAW_BACKUP_SECRET_ACCESS_KEY=
LGWRAW_BACKUP_BUCKET=
LGWRAW_BACKUP_PREFIX=backups
LGWRAW_BACKUP_PASSPHRASE=
